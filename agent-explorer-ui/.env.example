# Base URL of the agent-claude-nodejs API. Leave UNSET for local dev — requests stay
# relative (/api/*) via vite.config.ts's dev proxy to agents.yml's baseUrl instead.
VITE_API_BASE_URL=

# Comma-separated model names offered in the Model dropdown — must match ALLOWED_MODELS
# on the backend (agent-claude-nodejs/.env.example). Verified against the live API;
# adjust to whatever models are actually available through your Claude Agent SDK auth.
VITE_ALLOWED_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001,claude-opus-4-8
