PORT=4005

# Optional. The Claude Agent SDK spawns a Claude Code subprocess that reads this directly.
# Leave empty to use the Claude Code login (Claude subscription) instead.
ANTHROPIC_API_KEY=

# Optional. Overrides the Anthropic API base URL (e.g. for a corporate proxy/gateway).
# Leave unset to use the default api.anthropic.com.
ANTHROPIC_BASE_URL=

# Comma-separated allow-list for the /query "model" param. Verified against the live API
# (claude-sonnet-5 is the recommended default when "model" is omitted from a request).
# Leave empty to allow any model name through to the SDK.
ALLOWED_MODELS=claude-sonnet-5,claude-haiku-4-5-20251001,claude-opus-4-8

# Optional. Directory where sessions are saved as JSON, one <id>.json file each.
# Relative paths resolve from where the server is started. Default: data/session
SESSIONS_DIR=

# Optional. Directory where uploaded images are saved, one <id>.<ext> file each.
# Relative paths resolve from where the server is started. Default: data/assets
ASSETS_DIR=
