{
  "name": "agent-claude-nodejs",
  "version": "1.0.0",
  "description": "Simple agent backed by the Claude Agent SDK, run natively with Node's built-in TypeScript support.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch --watch-path=src src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "health": "curl -fsS \"http://localhost:${PORT:-4005}/health\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
